# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase project. URL and anon key are safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the server action to insert into the waitlist table.
# NEVER prefix with NEXT_PUBLIC_. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack incoming webhook for #taskpilot-signups. Server-only.
# The page never calls Slack; the server action does.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/WITH/WEBHOOK

# Public app URL (used in the Slack message for context).
NEXT_PUBLIC_APP_URL=http://localhost:3000
